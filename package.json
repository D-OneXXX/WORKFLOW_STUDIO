{
  "name": "dsh-workflow-studio",
  "version": "0.6.0",
  "private": true,
  "description": "Visual workflow studio for DeepSeek Harness: drag-and-drop DAG authoring, compile, and one-click run.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./shared": "./lib/shared/compiler.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "standalone:build": "node standalone/build.mjs",
    "standalone:start": "node standalone/server.mjs",
    "standalone:mcp": "node standalone/mcp.mjs",
    "standalone:test": "node tests/standalone.test.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node build.mjs && node scripts/test.mjs",
    "verify:descriptors": "node scripts/verify-descriptors.mjs",
    "verify:binding": "node scripts/stage-probe.mjs && node scripts/verify-binding.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify:descriptors && npm run verify:binding"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
