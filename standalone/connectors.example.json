{
  "defaultConnector": "codex-local",
  "connectors": [
    {
      "id": "codex-local",
      "kind": "cli",
      "label": "Codex（本机）",
      "command": "codex exec",
      "promptVia": "arg",
      "outputFormat": "text",
      "timeoutMs": 300000
    },
    {
      "id": "zcode-local",
      "kind": "cli",
      "label": "ZCode（本机）",
      "command": "zcode run",
      "promptVia": "stdin",
      "outputFormat": "text",
      "timeoutMs": 300000
    },
    {
      "id": "deepseek-api",
      "kind": "http",
      "label": "DeepSeek 云端",
      "url": "https://api.deepseek.com/chat/completions",
      "model": "deepseek-chat",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "timeoutMs": 120000
    },
    {
      "id": "local-llama",
      "kind": "http",
      "label": "本机推理服务",
      "url": "http://127.0.0.1:8080/v1/chat/completions",
      "model": "llama-3"
    },
    {
      "id": "harness",
      "kind": "mcp",
      "label": "Harness Agent",
      "command": "harness-mcp-bridge",
      "timeoutMs": 300000
    }
  ]
}
